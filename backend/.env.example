NODE_ENV=development
PORT=8080
FE_URL=http://localhost:3000
DATABASE_URL=postgresql://bookstation:bookstation@localhost:5432/bookstation
REDIS_URL=redis://localhost:6379
JWT_SECRET=
PAYMENT_HMAC_KEY=
# Cổng thanh toán SePay: sandbox | production, Merchant ID + Secret Key cùng môi trường
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
# Chuỗi "Secret Key" của IPN (Cổng thanh toán → Cấu hình → IPN), SePay gửi trong header X-Secret-Key
SEPAY_IPN_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
RESEND_API_KEY=
MAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
# Mật khẩu xuất hiện nhiều hơn số lần này trong dữ liệu rò rỉ (haveibeenpwned) thì bị từ chối
PWNED_PASSWORD_THRESHOLD=10
